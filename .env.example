# Cloudflare R2 Storage Configuration
# Find your Account ID in Cloudflare Dashboard -> R2 Overview (right sidebar)
# Create API tokens in R2 -> Manage R2 API Tokens (Permissions: Object Read & Write)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_r2_bucket_name
# Optional public custom domain or r2.dev URL for direct file downloads:
CLOUDFLARE_R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev
